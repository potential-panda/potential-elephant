[Unit]
Description=Elephant investment research API, dashboard and source scheduler on :9765
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/lulurun/workspace/Elephant
Environment=PYTHONPATH=src
Environment=PATH=/home/lulurun/.pyenv/versions/3.13.9/bin:/usr/local/bin:/usr/bin:/bin
# Bound to localhost: reached only through the public proxy (/elephant/). src/api.py's
# __main__ binds 0.0.0.0, so the unit starts uvicorn itself.
ExecStart=/home/lulurun/.pyenv/versions/3.13.9/bin/python -m uvicorn api:app --host 127.0.0.1 --port 9765
Restart=always
RestartSec=10
StandardOutput=append:/panda-infra/elephant/api.log
StandardError=append:/panda-infra/elephant/api.log

[Install]
WantedBy=default.target
