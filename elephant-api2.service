[Unit]
Description=Elephant V2 API and Scheduler
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/lulurun/workspace/potential-elephant
Environment=PYTHONPATH=src
Environment=PATH=/home/lulurun/.pyenv/versions/3.13.9/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/lulurun/.pyenv/versions/3.13.9/bin/python src/api2.py
Restart=always
RestartSec=10
StandardOutput=append:/panda-infra/elephant/api2.log
StandardError=append:/panda-infra/elephant/api2.log

[Install]
WantedBy=default.target
